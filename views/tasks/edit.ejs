<%- include('../partials/header') %>
  <section class="card" id="page-task-edit">
    <h1>Edit task</h1>
    <% if (error) { %><p class="error" id="task-edit-error"><%= error %></p><% } %>
    <form method="POST" action="/tasks/<%= task.id %>" class="stacked" id="form-edit-task">
      <label>Title
        <input type="text" name="title" id="input-task-title" value="<%= task.title %>" required autofocus />
      </label>
      <label>Description
        <textarea name="description" id="input-task-description" rows="3"><%= task.description || '' %></textarea>
      </label>
      <label>Priority
        <select name="priority" id="select-task-priority">
          <% ['low','medium','high'].forEach(p => { %>
            <option value="<%= p %>" <%= task.priority === p ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
      </label>
      <label>Due date
        <input type="date" name="due_date" id="input-task-due" value="<%= task.due_date || '' %>" />
      </label>
      <div class="row">
        <button type="submit" id="btn-save-task" data-action="save-task" class="primary">Save</button>
        <a href="/tasks" id="link-cancel-edit" class="link-btn">Cancel</a>
      </div>
    </form>
  </section>
<%- include('../partials/footer') %>
